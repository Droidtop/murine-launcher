<?xml version="1.0" encoding="utf-8"?>
<!--
     The host's toolbar action (MurineHooks.settings.toolbarRow; droidtop:
     Global settings), on every SettingsActivity instance (see that class's
     onPrepareOptionsMenu, which sets its title and icon and hides it with
     no host), not a row in any one screen's own preference list.
-->
<menu xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:id="@+id/action_global_settings"
        android:title="@string/pref_global_settings_title"
        android:icon="@drawable/ic_settings_general"
        android:showAsAction="always" />
</menu>
